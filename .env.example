# ── Golden Eagle Bot v2 — Environment Variables ──────────────────────────────
# Copy this file to .env and fill in your values before deploying.
# Never commit the actual .env file to git.

# ── Telegram API credentials ─────────────────────────────────────────────────
# Get from https://my.telegram.org/apps
API_ID=YOUR_API_ID
API_HASH=YOUR_API_HASH

# Bot token from @BotFather
BOT_TOKEN=YOUR_BOT_TOKEN

# ── Owner / Admin ─────────────────────────────────────────────────────────────
# Your Telegram numeric user ID (use /id in bot to get it)
OWNER=YOUR_TELEGRAM_USER_ID
OWNER_ID=YOUR_TELEGRAM_USER_ID

# ── Database ──────────────────────────────────────────────────────────────────
# MongoDB Atlas connection string
MONGO_URL=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
DATABASE_NAME=eagle

# ── Branding (optional) ───────────────────────────────────────────────────────
CREDIT=👨‍💻Your Name
CREDIT_LINK=https://t.me/yourusername

# ── Cookies file path (optional) ─────────────────────────────────────────────
cookies_file_path=youtube_cookies.txt

# ── Server port (used by gunicorn health-check server) ───────────────────────
PORT=8080
